# Copy to .env (git-ignored) and adjust. Nothing here is required to build or run the app.

# Bundle identifier of your build. It namespaces the Keychain items and the app preferences,
# so keep it stable once you have connected accounts. Used by script/build_and_run.sh.
BUNDLE_ID=app.trelune.mac
# CODESIGN_IDENTITY="Apple Development: Your Name (TEAMID)"

# Cloud publishing (optional, see docs/CLOUD.md). Used by cloud/deploy.sh.
# BUCKET=my-trelune-media
# REGION=us-east-1
# NAME=trelune
